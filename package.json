{
  "name": "lifeops-ai",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --runInBand --watch=false",
    "test:local-auth": "node scripts/local-auth-smoke.cjs",
    "format": "prettier --write \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\" package.json app.json tsconfig.json eslint.config.js jest.config.js jest.setup.js .prettierrc.json",
    "format:check": "prettier --check \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\" package.json app.json tsconfig.json eslint.config.js jest.config.js jest.setup.js .prettierrc.json",
    "config:check": "expo config --type public"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.118.0",
    "expo": "~58.0.17",
    "expo-constants": "~58.0.12",
    "expo-crypto": "58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-font": "~58.0.9",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "prettier": "^3.9.10",
    "supabase": "2.121.0",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  }
}
